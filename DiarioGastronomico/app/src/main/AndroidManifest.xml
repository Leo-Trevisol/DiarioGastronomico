<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DiarioGastronomico"
        tools:targetApi="31">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Autenticação -->
        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".CadastroActivity" android:exported="false" />

        <!-- Consumidor -->
        <activity android:name=".ExplorarActivity" android:exported="false" />
        <activity android:name=".RestauranteDetalheActivity" android:exported="false" />
        <activity android:name=".PratoDetalheActivity" android:exported="false" />
        <activity android:name=".AvaliarActivity" android:exported="false" />
        <activity android:name=".DiarioActivity" android:exported="false" />
        <activity android:name=".PerfilActivity" android:exported="false" />

        <!-- Restaurante -->
        <activity android:name=".RestaurantePainelActivity" android:exported="false" />
        <activity android:name=".GerenciarCardapioActivity" android:exported="false" />
        <activity android:name=".CadastroEstabelecimentoActivity" android:exported="false" />
        <activity android:name=".CadastroPratoActivity" android:exported="false" />
        <activity android:name=".AvaliacoesRecebidasActivity" android:exported="false" />

    </application>

</manifest>
